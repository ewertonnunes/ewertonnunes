"""
LLM-powered parameter extraction.

This is the ONLY component that calls an LLM. Everything downstream
(rendering, validation, git operations) is deterministic code.

Determinism strategy:
  1. temperature={{ model.temperature | pynum }}
  2. tool_choice forces the model to call build_service_spec
  3. Strict JSON schema (Pydantic + Anthropic input_schema)
  4. Pydantic validation as a second gate
  5. Retry loop with error feedback if validation fails
"""
from __future__ import annotations

import logging
import os
from dataclasses import dataclass

from anthropic import Anthropic
from pydantic import ValidationError

from .schemas import ServiceSpec, anthropic_tool_schema

logger = logging.getLogger(__name__)

MODEL = os.getenv("DEPLOY_AGENT_MODEL", "{{ model.default }}")
MAX_RETRIES = {{ model.max_retries }}

SYSTEM_PROMPT = """You are a deterministic deployment parameter extractor.

Your ONLY job is to call the build_service_spec tool with parameters
extracted from the user request.

Hard rules:
- Use ONLY values explicitly stated in the request or unambiguous from
  team conventions provided.
- If a required field is missing or ambiguous, set confidence="low"
  and pick the most conservative safe default (smallest size, dev env).
- NEVER invent service names, versions, or image names.
- NEVER suggest "improvements" to the request. Extract what's asked.
- Service names must match existing repo conventions: kebab-case,
  no env suffix (the env is a separate field).

Team conventions (always apply):
- prod requires >=2 replicas
- dev defaults to 1 replica, 256Mi memory, 100m CPU
- staging defaults to 2 replicas, 512Mi memory, 250m CPU
- default port is 8080 unless stated otherwise
"""


@dataclass
class ExtractionResult:
    spec: ServiceSpec
    raw_input: dict
    attempts: int


class ExtractionError(Exception):
    """Raised when the LLM cannot produce a valid spec after retries."""


def extract_spec(request: str, *, client: Anthropic | None = None) -> ExtractionResult:
    """
    Extract a ServiceSpec from a natural-language request.

    Raises ExtractionError if the LLM cannot produce a schema-valid spec
    within MAX_RETRIES attempts. This is a hard failure - the pipeline
    should escalate to a human, NOT guess.
    """
    client = client or Anthropic()
    tool = anthropic_tool_schema()

    messages: list[dict] = [{"role": "user", "content": request}]
    last_error: str | None = None

    for attempt in range(1, MAX_RETRIES + 1):
        if last_error:
            messages.append(
                {
                    "role": "user",
                    "content": (
                        f"Previous attempt failed validation: {last_error}\n"
                        "Correct the parameters and call the tool again."
                    ),
                }
            )

        response = client.messages.create(
            model=MODEL,
            max_tokens=1024,
            temperature={{ model.temperature | pynum }},
            system=SYSTEM_PROMPT,
            tools=[tool],
            tool_choice={"type": "tool", "name": "build_service_spec"},
            messages=messages,
        )

        tool_use = next(
            (b for b in response.content if b.type == "tool_use"),
            None,
        )
        if tool_use is None:
            last_error = "model did not call the tool"
            logger.warning("attempt %d: %s", attempt, last_error)
            continue

        try:
            spec = ServiceSpec.model_validate(tool_use.input)
        except ValidationError as exc:
            last_error = str(exc)
            logger.warning("attempt %d validation failed: %s", attempt, last_error)
            # feed the error back to the model on the next loop
            messages.append({"role": "assistant", "content": response.content})
            continue

        logger.info("extraction ok on attempt %d", attempt)
        return ExtractionResult(spec=spec, raw_input=tool_use.input, attempts=attempt)

    raise ExtractionError(
        f"Failed to extract valid spec after {MAX_RETRIES} attempts. "
        f"Last error: {last_error}"
    )
