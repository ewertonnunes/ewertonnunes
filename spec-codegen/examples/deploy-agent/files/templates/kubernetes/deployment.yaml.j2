apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ service_name }}
  namespace: {{ environment }}
  labels:
    app.kubernetes.io/name: {{ service_name }}
    app.kubernetes.io/version: "{{ version }}"
    app.kubernetes.io/managed-by: deploy-agent
    team: {{ team }}
spec:
  replicas: {{ replicas }}
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ service_name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ service_name }}
        app.kubernetes.io/version: "{{ version }}"
        team: {{ team }}
    spec:
      containers:
        - name: {{ service_name }}
          image: "{{ image }}:{{ version }}"
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: {{ port }}
              protocol: TCP
          resources:
            requests:
              memory: {{ memory }}
              cpu: {{ cpu }}
            limits:
              memory: {{ memory }}
              cpu: {{ cpu }}
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 10
            periodSeconds: 10
          readinessProbe:
            httpGet:
              path: /readyz
              port: http
            initialDelaySeconds: 5
            periodSeconds: 5
          securityContext:
            runAsNonRoot: true
            runAsUser: 10001
            readOnlyRootFilesystem: true
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
