apiVersion: v1
kind: Service
metadata:
  name: {{ service_name }}
  namespace: {{ environment }}
  labels:
    app.kubernetes.io/name: {{ service_name }}
    app.kubernetes.io/managed-by: deploy-agent
    team: {{ team }}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: {{ service_name }}
  ports:
    - name: http
      port: 80
      targetPort: {{ port }}
      protocol: TCP
